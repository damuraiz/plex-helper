package="plex-helper"
displayname="Plex Helper"
version="@VERSION@"
description="Independent media organizer: match films and TV, preview Plex paths, confirm changes, and undo safely."
maintainer="damuraiz"
maintainer_url="https://github.com/damuraiz/plex-helper"
arch="x86_64"
os_min_ver="7.2-72806"
thirdparty="yes"
ctl_stop="yes"
ctl_uninstall="yes"
precheckstartstop="yes"
silent_install="no"
silent_upgrade="yes"
silent_uninstall="yes"
dsmuidir="ui"
dsmappname="com.damuraiz.plexhelper"
checkport="no"
start_dep_services="network.target nginx.service"
instuninst_restart_services="nginx.service"
startstop_restart_services="nginx.service"
checksum="@CHECKSUM@"
